<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net8.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
            <ApplicationIcon>earthbound.ico</ApplicationIcon>
</PropertyGroup>

<ItemGroup>
	<PackageReference Include="OpenAL.NETCore" Version="1.0.3" />
	<PackageReference Include="OpenTK" Version="4.9.4" />
	<PackageReference Include="StbImageSharp" Version="2.30.15" />
	<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
            <!-- Added NVorbis for OGG support -->
            <PackageReference Include="NVorbis" Version="0.10.5" />
</ItemGroup>

<ItemGroup>
  <None Update="assets\UI\HUD\inventory\hotbar.png">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
  <None Update="assets\UI\HUD\inventory\inventory_grid_8x6.png">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
      <None Update="earthbound.ico">
<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
</None>
<None Update="assets\UI\HUD\inventory\slot.png">
<CopyToOutputDirectory>Always</CopyToOutputDirectory>
</None>
<!-- Copy Audio Assets -->
<None Update="assets\audio\**">
<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
</None>
<!-- Copy UI Assets including document -->
<None Update="assets\UI\Buttons\document.png">
<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
</None>
</ItemGroup>
</Project>
